<?xml version="1.0" encoding="utf-8"?>
<FrameLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:transitionGroup="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/headerContainer"
                android:layout_width="match_parent"
                android:layout_height="380dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:srcCompat="@tools:sample/backgrounds/scenic" />

                <View
                    android:id="@+id/headerGradient"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/header_gradient_bg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingBottom="12dp">

                    <code.name.monkey.retromusic.views.BaselineGridTextView
                        android:id="@+id/artistTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAppearance="@style/TextViewHeadline4"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        tools:text="Adele" />

                    <code.name.monkey.retromusic.views.BaselineGridTextView
                        android:id="@+id/text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="2dp"
                        android:textAppearance="@style/TextViewCaption"
                        android:textColor="#B3FFFFFF"
                        tools:text="3 Albums • 3 Songs • 13:45" />
                </LinearLayout>
            </FrameLayout>

            <include
                android:id="@+id/fragment_artist_content"
                layout="@layout/fragment_artist_content" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- الـ toolbar بقى شقيق للـ NestedScrollView مباشرة جوه rootLayout، مش
         جوه الصورة/الهيدر. كده بيفضل عايم فوق الشاشة كلها edge-to-edge طول
         الوقت (زي صفحة All songs بالظبط)، مهما سحبت لتحت، بدل ما يختفي مع
         الصورة بعد أول 380dp من السحب. -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@android:color/transparent"
        android:elevation="0dp">

        <code.name.monkey.retromusic.views.TintableToolbar
            android:id="@+id/toolbar"
            style="@style/Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:navigationIcon="@drawable/ic_arrow_back" />

    </com.google.android.material.appbar.AppBarLayout>

</FrameLayout>
